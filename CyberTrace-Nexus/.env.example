# CyberTrace Nexus Configuration
# Copy this file to .env and fill in the values

# ===================
# Security (REQUIRED)
# ===================

# REQUIRED: Secret key for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DO NOT use a placeholder value in production
JWT_SECRET_KEY=your-secret-key-here

# ===================
# Security (Production)
# ===================

# CORS allowed origins (comma-separated, no spaces)
# Defaults to localhost for development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Disable API docs in production (set to "true" to disable)
DISABLE_API_DOCS=false

# ===================
# Database
# ===================

# Database path (relative to project root)
# DB_PATH=data/forensics_framework.db

# ===================
# Backend
# ===================

# Backend host
HOST=0.0.0.0

# Backend port
PORT=8000

# ===================
# Frontend
# ===================

# API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
